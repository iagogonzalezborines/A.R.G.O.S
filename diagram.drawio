                </mxCell>
                <mxCell id="20" value="&lt;font color=&quot;#ffffff&quot;&gt;Wants the ai to perform an&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#ffffff&quot;&gt;an action on the system.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="18" vertex="1">
                    <mxGeometry x="7.5" y="36" width="159" height="41" as="geometry"/>
